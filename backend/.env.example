# ============================================================
# DeepSeek 配置
# ============================================================
# 在 https://platform.deepseek.com 创建。没有 Key 时服务会自动进入 mock 模式。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 服务配置
# ============================================================
# 允许跨域的前端地址（本地开发默认即可；生产环境同域反代时无需修改）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 强制 mock（不调用真实 API）
MOCK_MODE=false

# 单次请求超时（秒）
REQUEST_TIMEOUT=60

# 送给模型的历史消息条数上限（太长浪费 token，太短丢上下文）
AGENT_MAX_HISTORY=20
