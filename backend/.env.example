# ============================================================
# DeepSeek 配置
# ============================================================
# 在 https://platform.deepseek.com 创建。没有 Key 时服务会自动进入 mock 模式。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash 同时支持对话、工具调用和图片理解。
DEEPSEEK_MODEL=deepseek-flash
# 关闭“思考模式”（V4.1 默认开启）。博客助手不需要长思维链；
# 开着还可能出现 max_tokens 被思维链占满、正文为空的问题。
DEEPSEEK_DISABLE_THINKING=true

# ============================================================
# 服务配置
# ============================================================
# 允许跨域的前端地址（本地开发默认即可；生产环境同域反代时无需修改）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 强制 mock（不调用真实 API）
MOCK_MODE=false

# 单次请求超时（秒）
REQUEST_TIMEOUT=60

# 送给模型的历史消息条数上限（太长浪费 token，太短丢上下文）
AGENT_MAX_HISTORY=20

# --- 防失控：给 agent 的“模型 ↔ 工具”循环装保险丝 ---
# 一轮对话最多调用模型几次（每次工具往返算一次）。
AGENT_MAX_MODEL_CALLS=6
# 一轮对话最多执行几个工具。
AGENT_MAX_TOOL_CALLS=6
# 一轮对话最长多少秒；超时会给用户提示并结束。
AGENT_MAX_SECONDS=90

# ============================================================
# 登录凭证（与 WordPress 插件共享）
# ============================================================
# 和 wp-config.php 里的 L2D_AI_JWT_SECRET 完全相同，至少 32 个字符。
# 生成方式：openssl rand -hex 32
# 后端会用这个密钥验证插件签发的 token；没配置时聊天接口返回 503。
L2D_AI_JWT_SECRET=
# 下面三项必须和插件的常量一致，否则校验会失败。
L2D_AI_JWT_ISSUER=l2d-ai-wordpress
L2D_AI_JWT_AUDIENCE=l2d-ai-backend
# token 有效期（秒），插件签发 900 秒，这里保持一致。
L2D_AI_JWT_TTL_SECONDS=900
# 允许的服务器时钟偏差（秒），避免“刚签发就过期”的误判。
L2D_AI_JWT_LEEWAY_SECONDS=30

# ============================================================
# 每日聊天额度
# ============================================================
# 每个普通用户每天最多几条消息；管理员不限量。
# 0 表示普通用户完全不能聊天（管理员仍可用）。
DAILY_QUOTA=20
# 会员每天最多几条消息。会员仍限额，只是比普通用户高。
MEMBER_DAILY_QUOTA=60
# 全站普通用户每天合计最多几条消息；0 表示不限。
# 管理员聊天不计入全站额度。
GLOBAL_DAILY_QUOTA=0
# 额度计数数据库（相对 backend/ 目录）。删掉它会重置所有人的当天用量。
QUOTA_DB_PATH=data/quota.sqlite3
# 按哪个时区判断“新的一天”。
QUOTA_TIMEZONE=Asia/Shanghai
# 单个用户的额外额度存量上限。额外额度不会每天刷新，只增不减，
# 设上限是为了防止管理员发放时多打一个零（想发 100 发成 10000）。
CREDIT_MAX_PER_USER=10000

# ============================================================
# 运行时可改的运营参数
# ============================================================
# WordPress 后台“Live2D 小助手”设置页保存的额度、模型名等参数会写到这里。
# 相对 backend/ 目录；文件不存在时使用上面的 .env 默认值。
# 保存后立即生效，不需要重启服务。
RUNTIME_SETTINGS_PATH=data/runtime_settings.json

# ============================================================
# 人设文件
# ============================================================
# 真实人设正文放在 data/ 下，不会提交到 Git。
# 第一次运行先复制示例：cp -r personas.example data/personas
PERSONA_DIR=data/personas

# 没有 data/personas/active.json 时，加载这个人设的最新版本。
PERSONA_ID=merlin

# ============================================================
# QQ 通道（实验性，默认关闭）
# ============================================================
# 本地没有 NapCat 时，保持 QQ_ENABLED=false，网页聊天不受影响。
# 打开前先读 backend/README.md 的“QQ 本地联调”一节。
QQ_ENABLED=false

# NapCat 的 OneBot 11 HTTP API。只应监听 127.0.0.1，不要暴露到公网。
QQ_ONEBOT_BASE_URL=http://127.0.0.1:3000
QQ_ONEBOT_TOKEN=

# NapCat 回调 /api/channels/qq/events 时用的共享密钥。
# 生产环境必须设置；留空且不是 mock 模式时，接口返回 503。
# 注意：NapCat 的 HTTP 客户端不会明文发送它，而是发
# `X-Signature: sha1=HMAC-SHA1(token, 原始请求体)`，后端两种都认。
QQ_EVENT_TOKEN=

# 逗号分隔。群白名单为空时，任何群消息都不处理。
QQ_ALLOWED_GROUPS=
# 这些 QQ 号会被当成管理员（提示词里的称呼/权限不同）。
QQ_ADMIN_USERS=

# at：只有 @ 机器人时回复；prefix：以 QQ_PREFIX 开头；all：白名单群全部回复。
QQ_TRIGGER=at
QQ_PREFIX=梅林

# 每个群+用户保留多少轮短期对话（只在内存中，重启清空）。
QQ_HISTORY_TURNS=8

# 本地降级：为 true 时不发 HTTP，把出站消息写进 outbox 文件。
QQ_MOCK_MODE=false
QQ_MOCK_OUTBOX=data/qq_mock_outbox.jsonl

# ============================================================
# 站内知识库
# ============================================================
# 你的 WordPress 地址。同步脚本会依次尝试三种 REST 入口：
#   /wp-json/wp/v2/posts
#   /index.php/wp-json/wp/v2/posts
#   /?rest_route=/wp/v2/posts
WP_SITE_URL=https://example.com

# SQLite 数据库路径（相对 backend/ 目录）。文件不入库，随时可重建。
KB_DB_PATH=data/kb.sqlite3

# 每次检索最多返回几篇文章（1~10）
KB_TOP_K=4

# 文章切块大小与重叠字符数
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=80

# 拉取文章 / 下载图片的超时（秒）
KB_REQUEST_TIMEOUT=30
KB_USER_AGENT=WordPressAssistant-KB/1.0

# 单张图片最大字节数（默认 12 MB，超过就跳过）
KB_IMAGE_MAX_BYTES=12000000

# ============================================================
# 图片理解（用视觉模型把图片转成可检索文字）
# ============================================================
# 关闭后只索引 alt / 图注 / 文件名，不调用视觉模型。
VISION_ENABLED=true
VISION_MODEL=deepseek-flash
# low 更快更省；original 保留截图和代码细节。
VISION_DETAIL=original
VISION_MAX_TOKENS=800
